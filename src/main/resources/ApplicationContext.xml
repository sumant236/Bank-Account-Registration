<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="myUser" class="com.codingNinjas.Bank.Account.Registration.myUser" scope="singleton" init-method="init" destroy-method="destroy" />
    <bean id="savingAccount" class="com.codingNinjas.Bank.Account.Registration.savingsAccount" scope="prototype" init-method="init" />
    <bean id="currentAccount" class="com.codingNinjas.Bank.Account.Registration.currentAccount" scope="prototype" init-method="init" />
</beans>